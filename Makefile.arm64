# ArmtOS: the AArch64 build for the Raspberry Pi.
#
# The output is kernel8.img, the raw image the Pi's firmware loads at 0x80000. The x86
# build (Makefile) is untouched and still works; the two share the portable sources and
# differ in everything that talks to hardware.

CROSS   ?= aarch64-linux-gnu-
CC      := $(CROSS)gcc
LD      := $(CROSS)ld
OBJCOPY := $(CROSS)objcopy

ARCH_DIR := kernel/arch/arm64

CFLAGS := -ffreestanding -nostdlib -nostartfiles -nodefaultlibs -fno-builtin \
          -fno-stack-protector -fno-pic -fno-pie -mgeneral-regs-only \
          -O2 -Wall -Wextra -Werror -MMD -MP \
          -I. -I$(ARCH_DIR) -Ikernel/core -Ikernel/lib -Ikernel/micropython/ports/armtos

# MicroPython is third-party code and is not held to this build's warning settings; it also
# needs its own include paths and the port glue written for this architecture.
# -mgeneral-regs-only is left off here on purpose: MicroPython's object model names
# floating-point types even with float support disabled, and the kernel enables FP access
# at boot for exactly this reason.
MPFLAGS := -ffreestanding -nostdlib -nostartfiles -nodefaultlibs -fno-builtin \
           -fno-stack-protector -fno-pic -fno-pie -O2 -MMD -MP \
           -I. -I$(ARCH_DIR) -Ikernel/micropython -Ikernel/micropython/ports/tos \
           -Ikernel/micropython/ports/armtos -Ikernel/micropython/genhdr

# The network stack is the x86 kernel's, compiled as it is. compat/ comes first so that the few
# kernel services it includes (clock, terminal, klog, serial, scheduler) resolve to the board's
# versions; -Werror is off because this is code written for another target.
NETFLAGS := -ffreestanding -nostdlib -nostartfiles -nodefaultlibs -fno-builtin \
            -fno-stack-protector -fno-pic -fno-pie -mgeneral-regs-only -O2 -Wall -MMD -MP \
            -Wno-unused-function -Wno-unused-variable -Wno-unused-but-set-variable \
            -I$(ARCH_DIR)/compat -Ikernel/net -Ikernel/lib -Ikernel/core -I. -I$(ARCH_DIR)

ASFLAGS := $(CFLAGS)

OBJS := $(ARCH_DIR)/boot.arm.o \
        $(ARCH_DIR)/bcm.arm.o \
        $(ARCH_DIR)/uart.arm.o \
        $(ARCH_DIR)/mailbox.arm.o \
        $(ARCH_DIR)/dma.arm.o \
        $(ARCH_DIR)/gpio.arm.o \
        $(ARCH_DIR)/dwc2.arm.o \
        $(ARCH_DIR)/exception.arm.o \
        $(ARCH_DIR)/irq.arm.o \
        $(ARCH_DIR)/emmc.arm.o \
        $(ARCH_DIR)/mmu.arm.o \
        $(ARCH_DIR)/fb.arm.o \
        $(ARCH_DIR)/pwm.arm.o \
        $(ARCH_DIR)/i2c.arm.o \
        $(ARCH_DIR)/spi.arm.o \
        $(ARCH_DIR)/hwapi.arm.o \
        $(ARCH_DIR)/syscall_arm.arm.o \
        $(ARCH_DIR)/string_arm.arm.o \
        $(ARCH_DIR)/loader.arm.o \
        $(ARCH_DIR)/fat.arm.o \
        $(ARCH_DIR)/heap.arm.o \
        $(ARCH_DIR)/net.arm.o \
        $(ARCH_DIR)/genet.arm.o \
        $(ARCH_DIR)/lan95xx.arm.o \
        $(ARCH_DIR)/usbnet.arm.o \
        $(ARCH_DIR)/cfgfile.arm.o \
        $(ARCH_DIR)/raspi.arm.o \
        $(ARCH_DIR)/usbhid.arm.o \
        $(ARCH_DIR)/main.arm.o

MP_CORE := $(patsubst %.c,%.arm.o,$(filter-out %/persistentcode.c,$(wildcard kernel/micropython/py/*.c)))
MP_PORT := kernel/micropython/ports/tos/math_stubs.arm.o \
           kernel/micropython/ports/armtos/arm_hal.arm.o \
           kernel/micropython/ports/armtos/arm_mp.arm.o \
           kernel/micropython/ports/armtos/modpi.arm.o \
           kernel/micropython/shared/runtime/pyexec.arm.o \
           kernel/micropython/shared/runtime/sys_stdio_mphal.arm.o \
           kernel/micropython/shared/readline/readline.arm.o

# Everything in kernel/net/ except the PCI/port-I/O NIC drivers, the x86 probe and the x86
# entropy source, which arch/arm64/{nic_arm,csprng_arm,usbnet}.c replace.
NET_EXCLUDE := nic.c csprng.c e1000.c ne2000.c pcnet.c rtl8139.c virtio_net.c
NET_SRCS := $(filter-out $(addprefix kernel/net/,$(NET_EXCLUDE)),$(wildcard kernel/net/*.c))
NET_OBJS := $(NET_SRCS:.c=.arm.o)
OBJS += $(NET_OBJS) \
        $(ARCH_DIR)/netcompat.arm.o $(ARCH_DIR)/csprng_arm.arm.o $(ARCH_DIR)/nic_arm.arm.o \
        $(ARCH_DIR)/netcmd.arm.o $(ARCH_DIR)/desktop.arm.o \
        kernel/display/gfx.arm.o kernel/display/png.arm.o kernel/display/ui_assets.arm.o

OBJS += $(MP_CORE) $(MP_PORT)

DEPS := $(OBJS:.arm.o=.arm.d)

all: kernel8.img

kernel/micropython/py/%.arm.o: kernel/micropython/py/%.c
	$(CC) $(MPFLAGS) -c $< -o $@

kernel/micropython/shared/%.arm.o: kernel/micropython/shared/%.c
	$(CC) $(MPFLAGS) -c $< -o $@

kernel/micropython/ports/armtos/%.arm.o: kernel/micropython/ports/armtos/%.c
	$(CC) $(MPFLAGS) -c $< -o $@

kernel/micropython/ports/tos/%.arm.o: kernel/micropython/ports/tos/%.c
	$(CC) $(MPFLAGS) -c $< -o $@

kernel/net/%.arm.o: kernel/net/%.c
	$(CC) $(NETFLAGS) -c $< -o $@

$(ARCH_DIR)/netcompat.arm.o $(ARCH_DIR)/csprng_arm.arm.o $(ARCH_DIR)/nic_arm.arm.o: $(ARCH_DIR)/%.arm.o: $(ARCH_DIR)/%.c
	$(CC) $(NETFLAGS) -c $< -o $@

# the shell glue includes both this directory's headers and the stack's, so this directory wins
kernel/display/%.arm.o: kernel/display/%.c
	$(CC) $(NETFLAGS) -Ikernel/display -c $< -o $@

$(ARCH_DIR)/desktop.arm.o: $(ARCH_DIR)/desktop.c
	$(CC) $(filter-out -I$(ARCH_DIR) -I$(ARCH_DIR)/compat,$(NETFLAGS)) -I$(ARCH_DIR) -Ikernel/display -c $< -o $@

$(ARCH_DIR)/netcmd.arm.o: $(ARCH_DIR)/netcmd.c
	$(CC) $(filter-out -I$(ARCH_DIR) -I$(ARCH_DIR)/compat,$(NETFLAGS)) -I$(ARCH_DIR)/compat -I$(ARCH_DIR) -Ikernel/net -c $< -o $@

%.arm.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

%.arm.o: %.S
	$(CC) $(ASFLAGS) -c $< -o $@

kernel8.elf: $(OBJS) $(ARCH_DIR)/linker.ld
	$(LD) -T $(ARCH_DIR)/linker.ld -o $@ $(OBJS)

kernel8.img: kernel8.elf
	$(OBJCOPY) -O binary $< $@

clean:
	rm -f $(OBJS) $(DEPS) kernel8.elf kernel8.img

.PHONY: all clean
-include $(DEPS)
